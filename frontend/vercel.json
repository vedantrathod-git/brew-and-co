{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://brew-and-co-ggdd.onrender.com/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://brew-and-co-ggdd.onrender.com/health/:path*"
    },
    {
      "source": "/health",
      "destination": "https://brew-and-co-ggdd.onrender.com/health"
    },
    {
      "source": "/docs",
      "destination": "https://brew-and-co-ggdd.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://brew-and-co-ggdd.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
