# =============================================================================
# Frontend environment variables — copy to .env and fill in real values.
# NEVER put real credentials or secrets in this file.
# =============================================================================

# API Base URL
# ---------------------------------------------------------------------------
# Development (default):
#   Leave empty — Vite's dev server proxies /api/* to http://127.0.0.1:8000
#   so the frontend and backend appear same-origin during local development.
#
# Production (required):
#   Set this to your deployed backend's full HTTPS origin.
#   Example: https://restaurant-api.onrender.com
#
#   Cloudflare Pages → set under Settings › Environment variables (Production).
#   Do NOT include a trailing slash.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=
