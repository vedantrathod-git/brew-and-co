# Application Configuration
APP_NAME="Restaurant Management API"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# CORS Configuration (comma-separated list of allowed origins)
# Production example: ALLOWED_ORIGINS="https://restaurant-pos.pages.dev"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL with psycopg 3 driver)
# Development:  postgresql+psycopg://postgres:your_password_here@localhost:5432/restaurant_db
# Production:   postgresql+psycopg://user:pass@host.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql+psycopg://postgres:your_password_here@localhost:5432/restaurant_db"

# Authentication & JWT Configuration
# Generate a secure 256-bit random key in production:  openssl rand -hex 32
JWT_SECRET_KEY="generate_a_secure_random_hex_key_here_for_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cookie security
# Development: COOKIE_SECURE=False  (HTTP is fine locally)
# Production:  COOKIE_SECURE=True   (HTTPS required — enforced by config guardrail)
# Production:  COOKIE_SAMESITE=none (required for cross-origin Cloudflare → Render requests)
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# SQLAlchemy connection pool (tune for your database plan's connection limit)
# Neon free tier: max 10 connections — keep pool_size + max_overflow <= 5
# Larger plans or local Postgres: raise these values as needed
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Razorpay Test Mode Credentials (Sandbox)
# Obtain test credentials from Razorpay Dashboard: https://dashboard.razorpay.com -> Settings -> API Keys
# The test Key ID starts with 'rzp_test_'. Both Key ID and Key Secret are required.
# If these remain unset or placeholders, the API safely refuses checkout and directs customers to pay cash.
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_test_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"
RAZORPAY_CURRENCY="INR"
